# BridgeAI Environment Configuration
# Copy this file to .env and configure your variables

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
# If left empty, BridgeAI runs automatically in Demo Mode with rich sample scenarios.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model configuration (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
# Default is gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Server Port
PORT=3001

# Max upload file size in megabytes (default: 20MB)
MAX_FILE_SIZE_MB=20
