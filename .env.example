# BridgeAI Environment Configuration
# Copy this file to .env and configure your variables

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
# If left empty or set to a placeholder, BridgeAI automatically runs in Demo Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model configuration. Default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Frontend API origin. Leave blank for same-origin requests (recommended on Vercel).
VITE_API_BASE_URL=

# Enable Vercel Blob direct uploads on the deployed Vercel project.
# Create a PRIVATE Blob store and connect it to this project in Vercel Storage.
VITE_USE_VERCEL_BLOB_UPLOAD=false

# Gemini request timeout per attempt in milliseconds (default: 120000)
GEMINI_TIMEOUT_MS=120000

# Server Port
PORT=3001

# Max upload file size in megabytes (default: 10MB)
MAX_FILE_SIZE_MB=10
